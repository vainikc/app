# On Vercel the API is served from the same origin as the frontend
# (see the /api rewrite in vercel.json), so the base URL is empty and every
# call resolves to a relative "/api/...". This also keeps preview deployments
# pointing at their own backend instead of production.
REACT_APP_BACKEND_URL=
# CRA treats warnings as errors on CI, which fails the build on lint noise.
CI=false
